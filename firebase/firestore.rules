// Export Scout: Firebase has NOT been configured or deployed.
// SECURITY PLACEHOLDER - deny every request until member-scoped rules are
// implemented and tested with the Firebase Local Emulator Suite.
// Do not replace this with "allow read, write: if request.auth != null".
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
